# Salin file ini menjadi .env lalu isi nilainya.

# --- Supabase (tombol "Connect" > tab ORM) ---
# Ganti <PASSWORD> TANPA kurung siku. Karakter khusus di password harus di-encode (@ -> %40).
# Session pooler (port 5432) untuk aplikasi. Backend ini server yang terus menyala (Render/lokal),
# jadi session mode jauh lebih cepat (~100 ms/query) dibanding transaction mode 6543 (~600 ms/query).
# Hanya pakai port 6543 + ?pgbouncer=true jika backend di-deploy sebagai serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres?connection_limit=5"
# Session mode (port 5432) untuk migrasi Prisma:
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Server ---
PORT=4000
# Wajib diganti di production (string acak panjang)
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN=7d
# Origin frontend, pisahkan dengan koma bila lebih dari satu
CORS_ORIGIN=http://localhost:5173

# --- AI service (FastAPI) ---
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=15000
