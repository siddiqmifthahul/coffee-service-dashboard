{
  "name": "coffee-service-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API + realtime untuk Dashboard Rekapan Kasir Coffee Service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:db": "vitest run --mode db"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
